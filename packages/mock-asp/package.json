{
  "name": "@privacy-pools-v2/mock-asp",
  "version": "1.0.1",
  "private": true,
  "description": "Privacy Pools V2 mock ASP (Association Set Provider) — a chain-agnostic HTTP server with fault injection and an admin API, plus chain-specific adapters (EVM, Stellar). Dev/test tooling, not shipped.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./evm": {
      "types": "./dist/evm.d.ts",
      "import": "./dist/evm.js",
      "require": "./dist/evm.cjs"
    },
    "./stellar": {
      "types": "./dist/stellar.d.ts",
      "import": "./dist/stellar.js",
      "require": "./dist/stellar.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start:evm": "tsx src/cli/evm.ts",
    "start:stellar": "tsx src/cli/stellar.ts",
    "test": "pnpm typecheck && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "clean": "rm -rf dist",
    "format": "prettier --check \"{src,test}/**/*.{js,ts,json}\"",
    "format:fix": "prettier --write \"{src,test}/**/*.{js,ts,json}\"",
    "lint": "eslint -c ./eslint.config.mjs",
    "lint:fix": "eslint --fix -c ./eslint.config.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@privacy-pools-v2/core-sdk": "workspace:*",
    "@stellar/stellar-sdk": "^14.6.1",
    "viem": "2.45.3"
  },
  "devDependencies": {
    "@eslint/js": "catalog:lint",
    "@tsconfig/node22": "catalog:shared",
    "@types/node": "catalog:shared",
    "eslint": "catalog:lint",
    "eslint-config-prettier": "catalog:lint",
    "globals": "catalog:lint",
    "tsup": "^8.0.0",
    "tsx": "catalog:shared",
    "typescript": "catalog:shared",
    "typescript-eslint": "catalog:lint",
    "vitest": "^1.5.0"
  }
}
