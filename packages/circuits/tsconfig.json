{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "declaration": true,
    "resolveJsonModule": true,
    "typeRoots": ["./test/types", "./node_modules/@types"]
  },
  "include": ["test/**/*"],
  "exclude": ["node_modules", "build", "ptau"]
}
