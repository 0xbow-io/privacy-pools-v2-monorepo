{
  "name": "@privacy-pools-v2/e2e-suite",
  "version": "1.0.1",
  "private": true,
  "description": "Privacy Pools V2 chain-conformance e2e suite — the chain-agnostic behavioural ladders every chain SDK (evm-sdk, stellar-sdk, ...) must satisfy, parameterised by a chain driver each SDK supplies. Dev/test tooling, not shipped.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js",
      "require": "./dist/setup.cjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "test": "pnpm typecheck && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "clean": "rm -rf dist",
    "format": "prettier --check \"{src,test}/**/*.{js,ts,json}\"",
    "format:fix": "prettier --write \"{src,test}/**/*.{js,ts,json}\"",
    "lint": "eslint -c ./eslint.config.mjs",
    "lint:fix": "eslint --fix -c ./eslint.config.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@privacy-pools-v2/core-sdk": "workspace:*",
    "@privacy-pools-v2/mock-asp": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "catalog:lint",
    "@tsconfig/node22": "catalog:shared",
    "@types/node": "catalog:shared",
    "eslint": "catalog:lint",
    "eslint-config-prettier": "catalog:lint",
    "globals": "catalog:lint",
    "tsup": "^8.0.0",
    "typescript": "catalog:shared",
    "typescript-eslint": "catalog:lint",
    "vitest": "^1.5.0"
  }
}
