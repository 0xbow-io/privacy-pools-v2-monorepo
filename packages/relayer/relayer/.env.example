# ============================================================
# Privacy Pools Relayer — environment variables
# Copy this file to .env and fill in the values.
# ============================================================

# ----------------------------------------------------------------
# CORS_ORIGIN  [REQUIRED IN PRODUCTION]
#
# Comma-separated list of allowed browser origins.
# The default "*" is intentionally permissive for local development
# but MUST be replaced with the actual frontend origin(s) before any
# production deployment.  Leaving it as "*" in production allows any
# website to call the signing and relay routes from a browser.
#
# Example: CORS_ORIGIN=https://app.privacypools.com
# Multiple: CORS_ORIGIN=https://app.privacypools.com,https://staging.privacypools.com
#
# Both variables override the optional "cors" section of relayer.config.json
# ({ "origins": [...], "origin_patterns": [...] }); each replaces only its own
# dimension, and the exact list and the patterns are combined.
# ----------------------------------------------------------------
CORS_ORIGIN=*

# ----------------------------------------------------------------
# CORS_ORIGIN_PATTERN  [OPTIONAL]
#
# A single JS regular expression (NOT comma-separated — regexes may contain
# commas); origins matching it are allowed in addition to CORS_ORIGIN.
# Meant for per-branch preview deployments whose exact origin is not known
# in advance. Anchor the pattern (^...$) and pin your project/team suffix:
# a catch-all like ^https?://.*$ allows every website and defeats the
# allowlist — never use one in production.
#
# Example: CORS_ORIGIN_PATTERN=^https://privacy-pools-website-v2-git-[a-z0-9-]+-0xbow\.vercel\.app$
# ----------------------------------------------------------------
#CORS_ORIGIN_PATTERN=

# HTTP port the relayer listens on (default: 3000)
PORT=3000

# Path to the JSON relayer config file.
# Defaults to relayer.config.json next to the compiled dist/.
CONFIG_PATH=./relayer.config.json

# RPC endpoint for the target chain.
#
# Rate providers (Curve, CowSwap) resolve their RPC from this same value (or
# its per-chain RPC_URL_EVM_<chainId> override below) — there is no separate
# rate-provider RPC variable. Curve currently only has a verified oracle on
# Ethereum mainnet, so any supported_assets entry using quoter "Curve" only
# works for a chain whose RPC actually points at mainnet (chainId 1); see
# README.md's "Rate Provider Chain Support" section for how to add more.
RPC_URL=http://localhost:8545

# Per-chain override for RPC_URL above, e.g.:
# RPC_URL_EVM_1=https://mainnet.example.com

# Must be "true" for the "Mock" rate provider (hardcoded 1:1 pricing) to be
# registered at all. Without it, any asset configured with quoter "Mock" fails
# at the first quote request instead of silently pricing fees off a fake rate.
# Local/test use only — never set in production.
# ALLOW_MOCK_RATE_PROVIDER=true

# Quote commitment expiration window in milliseconds.
# Omit to use the chain-config default.
# QUOTE_EXPIRATION_MS=120000

# Log level: error | warn | info | debug (default: info in production, debug otherwise)
# LOG_LEVEL=info

# Set to "production" to enable production log level defaults and other guards.
# NODE_ENV=production

# Pub/Sub topic the relayer publishes operational alerts to (turbo-level faults +
# records logged with `alert: true`, e.g. dust-rescue degraded-but-succeeded warnings).
# Consumed by the standalone alert-dispatcher service. Defaults to "relayer-alerts".
# RELAYER_ALERTS_PUBSUB_TOPIC=relayer-alerts

# Set to "true" to disable alert publishing without a redeploy (e.g. if Telegram
# delivery itself starts misbehaving). Logging at turbo/error still happens either way.
# RELAYER_ALERTS_DISABLED=false
