{
    "extends": "@tsconfig/node22",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "isolatedModules": true,
        "resolveJsonModule": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "types": ["jest"]
    },
    "include": ["src", "test"],
    "exclude": ["node_modules", "dist"]
}
