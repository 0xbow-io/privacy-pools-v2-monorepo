pragma solidity 0.8.32;

/// @title IGroth16Verifier
/// @notice Interface for Groth16 SNARK verifiers generated by snarkjs
/// @dev Each circuit has a unique number of public signals, so the verifyProof
///      function signature varies. This interface documents the common pattern:
///
///      function verifyProof(
///          uint256[2] calldata _pA,      // G1 point (proof.pi_a)
///          uint256[2][2] calldata _pB,   // G2 point (proof.pi_b)
///          uint256[2] calldata _pC,      // G1 point (proof.pi_c)
///          uint256[N] calldata _pubSignals // Public signals (circuit-specific)
///      ) external view returns (bool);
///
///      Circuit-specific public signals (see ProofLibV2 for layout):
///      - Deposit (4): [outputCommitment, tokenId, value, context]
///      - Ragequit (7): [nullifierHash, commitment, keystoreRoot, ownerAddress, value, tokenId, label]
///      - Transact NxM (calldata tail after proof points, per TransactVerifierRouter): nullifierHashes[N],
///        outputCommitments[M], then [stateRoot, keyRegistryRoot, associationSetRoot, amountOut, tokenIdOut, context]
interface IGroth16Verifier {
  /// @notice Struct representing a Groth16 proof
  /// @dev Used for calldata encoding in wrapper contracts
  /// @param pA G1 point (proof.pi_a)
  /// @param pB G2 point (proof.pi_b)
  /// @param pC G1 point (proof.pi_c)
  struct Proof {
    uint256[2] pA;
    uint256[2][2] pB;
    uint256[2] pC;
  }
}
