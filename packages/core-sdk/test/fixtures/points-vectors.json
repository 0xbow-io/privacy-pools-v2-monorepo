{
  "description": "Points v1 accrual test vectors. One vector = one note in one epoch, i.e. one claim. All integers are decimal strings; times are unix seconds.",
  "formula": {
    "pointsWei": "floor(value * rate * cohortBps * cliffOverlap / (rateScale * 10000))",
    "cliffOverlap": "max(0, min(end, snapshotTime) - max(createdAt + cliffSeconds, windowStart)), end = spentAt if spent else snapshotTime",
    "cohortBps": "cohortWeightsBps[k], k = number of cohortEdges <= createdAt (a note created exactly at an edge is in the next, lower tier)",
    "rate": "points-wei per base-unit-second scaled by rateScale; a tokenId absent from the epoch's rate tree (rate null here) earns 0",
    "tokenRate": "roundHalfUp(pointsWeiPerUsdDay * rateScale * price / (86400 * 10^assetDecimals * 10^priceDecimals))",
    "shareRate": "roundHalfUp(pointsWeiPerUsdDay * rateScale * underlyingPrice * assetsPerShareUnit / (86400 * 10^underlyingDecimals * 10^priceDecimals * 10^shareDecimals))",
    "roundHalfUp": "floor((2n + d) / (2d))",
    "unreachedCohortEdge": "2^47 + tier"
  },
  "vectors": [
