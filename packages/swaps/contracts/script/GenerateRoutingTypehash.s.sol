pragma solidity 0.8.32;

import {Script, console} from "forge-std/Script.sol";
import {RoutingAst} from "./helpers/RoutingAst.sol";

/// @notice RC-32: (re)generates `src/generated/RoutingTypehash.sol` from RelaySwaps.sol's
///   actual compiled `SwapRouting`/`DustRescue` shape (solc's own AST — `RoutingAst`, same
///   helper `RoutingLayout.t.sol` uses to verify the result), so nobody hand-types the
///   EIP-712 encodeType string `ROUTING_TYPEHASH()` hashes.
///
/// Run after any change to those structs' fields, types, or order:
///
///   forge script script/GenerateRoutingTypehash.s.sol
///
/// then re-run `forge test --match-path test/RoutingLayout.t.sol` (or the full suite) to
/// confirm the regenerated file matches what got written. No broadcast, no on-chain
/// transaction — this only reads the local build output and writes a local source file.
contract GenerateRoutingTypehash is Script {
    string internal constant OUTPUT_PATH = "src/generated/RoutingTypehash.sol";

    function run() external {
        string memory implJson = vm.readFile("out/RelaySwaps.sol/RelaySwaps.json");
        string memory encodeType = string.concat(
            RoutingAst.encodeTypeFor(vm, implJson, "RelaySwaps", "SwapRouting"),
            RoutingAst.encodeTypeFor(vm, implJson, "RelaySwaps", "DustRescue")
        );

        string memory file = string.concat(
            "// SPDX-License-Identifier: BUSL-1.1\n",
            "pragma solidity 0.8.32;\n",
            "\n",
            "// AUTO-GENERATED by `forge script script/GenerateRoutingTypehash.s.sol` -- do not hand-edit.\n",
            "//\n",
            "// Regenerate after any change to RelaySwaps.SwapRouting or RelaySwaps.DustRescue's fields,\n",
            "// types, or order:\n",
            "//\n",
            "//   forge script script/GenerateRoutingTypehash.s.sol\n",
            "//\n",
            "// RC-32: RelaySwaps.ROUTING_TYPEHASH() used to hash a hand-typed copy of this string, which\n",
            "// is exactly the kind of manually-synced value that drifted from the struct it describes in\n",
            "// the first place. This file is derived mechanically from solc's own AST (see\n",
            "// script/GenerateRoutingTypehash.s.sol and script/lib/RoutingAst.sol) instead, so nobody\n",
            "// types it by hand. `RoutingLayout.t.sol` fails the build if it and the struct's actual\n",
            "// compiled shape ever disagree -- that's the signal to rerun the command above, not to edit\n",
            "// the string here directly.\n",
            "string constant ROUTING_ENCODE_TYPE =\n",
            '    "',
            encodeType,
            '";\n'
        );

        vm.writeFile(OUTPUT_PATH, file);
        console.log("Wrote", OUTPUT_PATH);
        console.log("ROUTING_ENCODE_TYPE:", encodeType);
        console.logBytes32(keccak256(bytes(encodeType)));
    }
}
